{
  "name": "siyuan-plugin-batch-manager",
  "version": "0.2.0",
  "description": "Batch manage SiYuan documents: browse, filter, select, batch delete/export/move/rename",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "makeLink": "node scripts/make-link.cjs",
    "install:plugin": "node scripts/install.cjs",
    "test:acceptance": "node scripts/acceptance.cjs"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "batch",
    "export",
    "rename",
    "move",
    "delete"
  ],
  "license": "AGPL-3.0",
  "author": "hh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hh/siyuan-plugin-batch-manager.git"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "siyuan": "^1.2.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/node": "^26.5.0",
    "svelte": "^4.2.20",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
